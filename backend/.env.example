# Copy to .env and fill in. Never commit .env.

# local | staging | production
APP_ENV=local

# Cloud Supabase Postgres (required).
# Dashboard -> Connect -> Transaction pooler (port 6543). Replace [YOUR-PASSWORD] with the database password.
# Example: postgresql://postgres.abcdefghijkl:[YOUR-PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:6543/postgres
DATABASE_URL=

# Supabase project URL, e.g. https://abcdefghijkl.supabase.co (used to check CRM sign-in tokens).
# The publishable key (sb_publishable_...) is for the CRM frontend only and does not go here.
SUPABASE_URL=

# Redis is Phase 2. Leave empty: sessions, slot holds and rate limits use Postgres and memory.
REDIS_URL=

# Websites allowed to call the API, comma separated
ALLOWED_ORIGINS=https://neofollicletransplant.com,https://neofertility.co.in,https://dermasolutions.co.in,http://localhost:5173,http://localhost:4173

# LLM fallback. Empty = switched off; the bot takes a lead instead.
GROQ_API_KEY=
GEMINI_API_KEY=

# WhatsApp. Empty = mocked (messages are logged, not sent).
INTERAKT_API_KEY=

# Embedding model for the knowledge base (downloads on first use, about 130 MB)
EMBED_MODEL=BAAI/bge-small-en-v1.5
